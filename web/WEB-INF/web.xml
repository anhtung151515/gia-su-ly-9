    <!-- ================= FILTERS ================= -->
    <filter>
        <filter-name>AuthFilter</filter-name>
        <filter-class>com.giasuly9.filter.AuthFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>AuthFilter</filter-name>
        <url-pattern>/student/*</url-pattern>
    </filter-mapping>
    <filter-mapping>
        <filter-name>AuthFilter</filter-name>
        <url-pattern>/teacher/*</url-pattern>
    </filter-mapping>
    <filter-mapping>
        <filter-name>AuthFilter</filter-name>
        <url-pattern>/admin/*</url-pattern>
    </filter-mapping>
    <filter-mapping>
        <filter-name>AuthFilter</filter-name>
        <url-pattern>/practice/*</url-pattern>
    </filter-mapping>
    <filter-mapping>
        <filter-name>AuthFilter</filter-name>
        <url-pattern>/tutor/*</url-pattern>
    </filter-mapping>
    <filter-mapping>
        <filter-name>AuthFilter</filter-name>
        <url-pattern>/ai-chat</url-pattern>
    </filter-mapping>
    <filter-mapping>
        <filter-name>AuthFilter</filter-name>
        <url-pattern>/ai-chat/*</url-pattern>
    </filter-mapping>

    <filter>
        <filter-name>RoleFilter</filter-name>
        <filter-class>com.giasuly9.filter.RoleFilter</filter-class>
        <init-param>
            <param-name>roles</param-name>
            <param-value>ADMIN</param-value>
        </init-param>
    </filter>
    <filter-mapping>
        <filter-name>RoleFilter</filter-name>
        <url-pattern>/admin/*</url-pattern>
    </filter-mapping>

    <filter>
        <filter-name>TeacherRoleFilter</filter-name>
        <filter-class>com.giasuly9.filter.RoleFilter</filter-class>
        <init-param>
            <param-name>roles</param-name>
            <param-value>ADMIN,TEACHER</param-value>
        </init-param>
    </filter>
    <filter-mapping>
        <filter-name>TeacherRoleFilter</filter-name>
        <url-pattern>/teacher/*</url-pattern>
    </filter-mapping>

    <filter>
        <filter-name>StudentRoleFilter</filter-name>
        <filter-class>com.giasuly9.filter.RoleFilter</filter-class>
        <init-param>
            <param-name>roles</param-name>
            <param-value>ADMIN,TEACHER,STUDENT</param-value>
        </init-param>
    </filter>
    <filter-mapping>
        <filter-name>StudentRoleFilter</filter-name>
        <url-pattern>/student/*</url-pattern>
    </filter-mapping>
    <filter-mapping>
        <filter-name>StudentRoleFilter</filter-name>
        <url-pattern>/practice/*</url-pattern>
    </filter-mapping>
    <filter-mapping>
        <filter-name>StudentRoleFilter</filter-name>
        <url-pattern>/tutor/*</url-pattern>
    </filter-mapping>
    <filter-mapping>
        <filter-name>StudentRoleFilter</filter-name>
        <url-pattern>/ai-chat</url-pattern>
    </filter-mapping>
    <filter-mapping>
        <filter-name>StudentRoleFilter</filter-name>
        <url-pattern>/ai-chat/*</url-pattern>
    </filter-mapping>

    <welcome-file-list>
        <welcome-file>home</welcome-file>
    </welcome-file-list>

    <session-config>
        <session-timeout>60</session-timeout>
    </session-config>
</web-app>
