    <servlet>
        <servlet-name>PracticeController</servlet-name>
        <servlet-class>com.giasuly9.controller.PracticeController</servlet-class>
        <multipart-config>
            <max-file-size>5242880</max-file-size>
            <max-request-size>10485760</max-request-size>
            <file-size-threshold>0</file-size-threshold>
        </multipart-config>
    </servlet>
    <servlet-mapping>
        <servlet-name>PracticeController</servlet-name>
        <url-pattern>/practice/start</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>PracticeController</servlet-name>
        <url-pattern>/practice/question</url-pattern>
    </servlet-mapping>
