<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ page import="com.giasuly9.model.User" %>
<%
    String topTitle = (String) request.getAttribute("pageTitle");
    if (topTitle == null) { topTitle = "Quản trị"; }
    User topUser = null;
    if (request.getSession(false) != null) {
        Object rawUser = request.getSession(false).getAttribute("user");
        if (rawUser instanceof User) {
            topUser = (User) rawUser;
        }
    }
    String topRole = topUser != null ? topUser.getRole() : "";
%>
<header class="app-topbar">
    <div class="fw-bold" style="font-size:1.02rem;"><%= topTitle %></div>
    <div class="d-flex align-items-center gap-3">
        <a href="${pageContext.request.contextPath}/ai-chat" class="btn btn-sm btn-outline-primary">
            <i class="bi bi-stars"></i> AI giải bài
        </a>
        <div class="dropdown">
            <button class="user-chip dropdown-toggle" type="button" data-bs-toggle="dropdown">
                <span class="user-avatar"><i class="bi bi-person-fill"></i></span>
                <%= topUser == null ? "" : topUser.getFullName() %>
                <span class="role-badge <%= topRole %>"><%= topRole %></span>
            </button>
            <ul class="dropdown-menu dropdown-menu-end">
                <li><a class="dropdown-item" href="${pageContext.request.contextPath}/home"><i class="bi bi-house"></i> Trang chủ</a></li>
                <li><a class="dropdown-item" href="${pageContext.request.contextPath}/ai-chat"><i class="bi bi-stars"></i> AI giải bài</a></li>
                <li><hr class="dropdown-divider"></li>
                <li><a class="dropdown-item text-danger" href="${pageContext.request.contextPath}/logout"><i class="bi bi-box-arrow-right"></i> Đăng xuất</a></li>
            </ul>
        </div>
    </div>
</header>
